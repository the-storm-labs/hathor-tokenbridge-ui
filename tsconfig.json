{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    // The legacy scripts in src/js are classic (non-module) scripts sharing ~45
    // undeclared cross-file globals. Type-checking them would emit hundreds of
    // errors on code whose planned lifespan is a few weeks. We check the
    // destination, not the source: the migration signal is "is it in src/app yet".
    "allowJs": false,
    "checkJs": false,

    // "node" is for test files only (node:crypto in the address test); the app
    // code itself must never import a node builtin.
    "types": ["vite/client", "node"]
  },
  "include": ["src/app", "src/types"],
  "exclude": ["src/js", "src/txns-storage.js", "public", "node_modules"]
}
