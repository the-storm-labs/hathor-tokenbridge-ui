# Base URL of the Hathor Bridge Read API (see docs/bridge-api.yaml).
# No trailing slash, no path -- the client appends /transactions-by-receiver.
VITE_BRIDGE_API_URL=https://xw6u4wka61.execute-api.us-east-2.amazonaws.com

# EVM JSON-RPC endpoints
VITE_EVM_HOST_MAINNET=https://arbitrum-mainnet.infura.io/v3/<infura-project-id>
VITE_EVM_HOST_TESTNET=https://sepolia.infura.io/v3/<infura-project-id>
