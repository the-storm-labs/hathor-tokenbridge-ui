# Base URL of the Hathor Bridge Read API (see docs/bridge-api.yaml).
# No trailing slash, no path -- the client appends /transactions-by-receiver.
VITE_BRIDGE_API_URL=https://xw6u4wka61.execute-api.us-east-2.amazonaws.com
# The Read API for testnet-arb.html (Arbitrum Sepolia, 2-of-3). No deployed one
# exists yet; locally, hathor-functions' run-http-server.ts serves it, e.g.
# http://localhost:3001. Empty: that page's history is only what this browser sent.
VITE_BRIDGE_API_URL_TESTNET_ARB=

# EVM JSON-RPC endpoints.
#
# Every wallet-triggered chain call still goes through the connected wallet's
# own provider. The one reader of these is the HTR->ARB EIP-7702 delegation
# check (adapters/driven/evm/eip7702-delegation.adapter.ts): it has to work
# with no EVM wallet connected at all, so it needs its own RPC. Fails open if
# empty or unreachable -- see that adapter -- so a missing value degrades
# instead of blocking every HTR->ARB transfer.
VITE_EVM_HOST_MAINNET=https://arbitrum-mainnet.infura.io/v3/<infura-project-id>
VITE_EVM_HOST_TESTNET=https://sepolia.infura.io/v3/<infura-project-id>
# Arbitrum Sepolia, for testnet-arb.html. Optional: falls back to the public
# arbitrum-sepolia-rpc.publicnode.com when empty.
VITE_EVM_HOST_TESTNET_ARB=
